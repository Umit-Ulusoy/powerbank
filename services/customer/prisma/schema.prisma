
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  customerNumber String         @unique @map("customer_number") @db.VarChar(20)
  firstName      String         @map("first_name") @db.VarChar(100)
  lastName       String         @map("last_name") @db.VarChar(100)
  status         CustomerStatus @default(PENDING_VERIFICATION)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  contacts      CustomerContact[]
  statusHistory CustomerStatusHistory[]

  @@index([status, createdAt(sort: Desc)])
  @@map("customers")
}

model CustomerContact {
  id              String      @id @default(uuid()) @db.Uuid
  customerId      String      @map("customer_id") @db.Uuid
  type            ContactType
  value           String      @db.VarChar(255)
  normalizedValue String      @map("normalized_value") @db.VarChar(255)
  isPrimary       Boolean     @default(false) @map("is_primary")
  verifiedAt      DateTime?   @map("verified_at") @db.Timestamptz(6)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@unique([type, normalizedValue])
  @@map("customer_contacts")
}

model CustomerStatusHistory {
  id             String         @id @default(uuid()) @db.Uuid
  customerId     String         @map("customer_id") @db.Uuid
  previousStatus CustomerStatus? @map("previous_status")
  newStatus      CustomerStatus @map("new_status")
  reasonCode     String?        @map("reason_code") @db.VarChar(100)
  actorType      String         @map("actor_type") @db.VarChar(30)
  actorId        String?        @map("actor_id") @db.VarChar(100)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt(sort: Desc)])
  @@map("customer_status_history")
}

enum CustomerStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ContactType {
  EMAIL
  PHONE
}
